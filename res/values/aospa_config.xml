<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Whether the face HAL supports the require attention feature -->
    <bool name="config_face_attention_supported">true</bool>

    <!-- Whether Settings should open a separate camera preview during face enrollment -->
    <bool name="config_face_enroll_hal_owns_camera">false</bool>

    <!-- HAL-owned face preview size, must match a supported camera size -->
    <integer name="face_preview_width">1080</integer>
    <integer name="face_preview_height">1080</integer>

    <!-- Face enrollment posture guidance (devices that require a specific posture) -->
    <string name="face_enrolling_close_to_continue">Fold phone during setup</string>
    <string name="face_enrolling_close_to_continue_description">The phone must be folded to set up or use Face Unlock</string>
    <string name="face_enrolling_do_it_later">Do it later</string>

    <!-- Whether device supports increased touch sensitvity -->
    <bool name="config_supportGloveMode">true</bool>

    <!-- Whether device supports high touch polling rate -->
    <bool name="config_supportTouchPollingMode">true</bool>
</resources>
